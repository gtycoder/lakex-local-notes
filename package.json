{
  "name": "lake-notes-electron",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 Lake 编辑器笔记应用（Electron 桌面端）",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "dev:vite": "vite --host 127.0.0.1 --port 1421",
    "dev:electron": "electron .",
    "build": "tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "node scripts/e2e-electron-smoke.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:packaged": "node scripts/e2e-packaged-smoke.mjs",
    "test:drawnix": "node scripts/e2e-drawnix-smoke.mjs",
    "benchmark:workspace": "LAKE_RUN_BENCHMARK=1 vitest run electron/workspace.benchmark.test.ts --reporter=verbose",
    "test:window-state": "node scripts/e2e-window-state-smoke.mjs",
    "test:renderer-recovery": "node scripts/e2e-renderer-recovery-smoke.mjs",
    "test:packaged:full": "npm run test:window-state && npm run test:packaged && npm run test:renderer-recovery",
    "benchmark:tabs": "node scripts/e2e-tab-lifecycle-benchmark.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "lakex-drawnix": "^0.1.0",
    "lakex-drawnix-react-board": "^0.1.0",
    "lakex-drawnix-react-text": "^0.1.0",
    "lakex-editor-react-component": "^0.1.2",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.3",
    "slate": "^0.116.0",
    "slate-dom": "^0.116.0",
    "slate-react": "^0.116.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.0.1",
    "sass": "^1.102.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.lakenotes.electron",
    "productName": "Lake Notes",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "!**/*.map",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/build/Release/obj/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "electron/preload.cjs"
    ],
    "icon": "build/icon.png"
  }
}
