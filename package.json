{
  "name": "lake-notes-electron",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 Lake 编辑器笔记应用（Electron 桌面端）",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "dev:vite": "vite --host 127.0.0.1 --port 1421",
    "dev:electron": "electron .",
    "build": "tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "node scripts/e2e-electron-smoke.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:core": "node scripts/check-core-boundaries.mjs",
    "check:stylesnap": "node scripts/css-audit/check-stylesnap.mjs",
    "check:mobilesnap": "node scripts/mobile-audit/check-mobile-snap.mjs",
    "test:packaged": "node scripts/e2e-packaged-smoke.mjs",
    "test:drawnix": "node scripts/e2e-drawnix-smoke.mjs",
    "benchmark:workspace": "LAKE_RUN_BENCHMARK=1 vitest run electron/workspace.benchmark.test.ts --reporter=verbose",
    "test:window-state": "node scripts/e2e-window-state-smoke.mjs",
    "test:renderer-recovery": "node scripts/e2e-renderer-recovery-smoke.mjs",
    "test:packaged:full": "npm run test:window-state && npm run test:packaged && npm run test:renderer-recovery && npm run test:service-crash",
    "benchmark:tabs": "node scripts/e2e-tab-lifecycle-benchmark.mjs",
    "test:service-crash": "node scripts/e2e-service-crash-smoke.mjs",
    "test:sidebar-interaction": "node scripts/e2e-sidebar-interaction-smoke.mjs",
    "test:tab-switch": "node scripts/e2e-tab-switch-smoke.mjs",
    "postinstall": "patch-package --patch-dir vendor/lakex-doc-react/patches && patch-package --patch-dir patches",
    "build:vendor": "npm --prefix vendor/lakex-doc-react run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@dlient/lakex-doc-react": "file:./vendor/lakex-doc-react",
    "@fortune-sheet/react": "1.0.4",
    "lakex-drawnix": "^0.1.0",
    "lakex-drawnix-react-board": "^0.1.0",
    "lakex-drawnix-react-text": "^0.1.0",
    "lucide-react": "^1.45.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "slate": "^0.116.0",
    "slate-dom": "^0.116.0",
    "slate-react": "^0.116.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.0",
    "sass": "^1.104.1",
    "sql.js": "^1.13.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.lakenotes.electron",
    "productName": "Lake Notes",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "!**/*.map",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/build/Release/obj/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "electron/preload.cjs"
    ],
    "icon": "build/icon.png"
  }
}
