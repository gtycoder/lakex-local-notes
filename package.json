{
  "name": "lakex-local-notes",
  "version": "0.0.1",
  "private": true,
  "description": "本地优先的 Lake 编辑器笔记应用（Electron 桌面端）",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:doctor": "node scripts/dev.mjs --doctor",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:vite": "vite --host 127.0.0.1 --port 1421",
    "dev:electron": "electron .",
    "build": "tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "node scripts/e2e-electron-smoke.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs && node scripts/css-audit/audit-vendor-css.mjs",
    "check:core": "node scripts/check-core-boundaries.mjs",
    "check:stylesnap": "node scripts/css-audit/check-stylesnap.mjs",
    "check:mobilesnap": "node scripts/mobile-audit/check-mobile-snap.mjs",
    "test:packaged": "node scripts/e2e-packaged-smoke.mjs",
    "test:drawnix": "node scripts/e2e-drawnix-smoke.mjs",
    "benchmark:workspace": "LAKE_RUN_BENCHMARK=1 vitest run electron/workspace.benchmark.test.ts --reporter=verbose",
    "test:window-state": "node scripts/e2e-window-state-smoke.mjs",
    "test:renderer-recovery": "node scripts/e2e-renderer-recovery-smoke.mjs",
    "test:packaged:full": "npm run test:window-state && npm run test:packaged && npm run test:renderer-recovery && npm run test:service-crash",
    "benchmark:tabs": "node scripts/e2e-tab-lifecycle-benchmark.mjs",
    "test:service-crash": "node scripts/e2e-service-crash-smoke.mjs",
    "test:sidebar-interaction": "node scripts/e2e-sidebar-interaction-smoke.mjs",
    "test:tab-switch": "node scripts/e2e-tab-switch-smoke.mjs",
    "preinstall": "node scripts/setup-lakex-private.mjs",
    "setup:lakex": "node scripts/setup-lakex-private.mjs",
    "setup:remotes": "node scripts/setup-remotes.mjs",
    "backup:lakex": "node scripts/setup-lakex-private.mjs --backup",
    "postinstall": "install-electron && patch-package --patch-dir vendor/lakex-doc-react/patches && patch-package --patch-dir patches",
    "build:vendor": "npm --prefix vendor/lakex-doc-react run build",
    "build:web": "vite build",
    "build:web:watch": "vite build --watch",
    "check:mobileui": "node scripts/check-mobile-ui.mjs",
    "check:android-release": "node scripts/check-android-release-config.mjs",
    "test:bitable:packaged": "node scripts/packaged-performance/bitable/run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@univerjs/engine-render": "1.0.3",
    "@univerjs/find-replace": "1.0.3",
    "@univerjs/preset-sheets-core": "1.0.3",
    "@univerjs/preset-sheets-drawing": "1.0.3",
    "@univerjs/preset-sheets-find-replace": "1.0.3",
    "@univerjs/preset-sheets-hyper-link": "1.0.3",
    "@univerjs/preset-sheets-note": "1.0.3",
    "@univerjs/presets": "1.0.3",
    "@univerjs/sheets-crosshair-highlight": "1.0.3",
    "@univerjs/sheets-filter": "1.0.3",
    "@univerjs/sheets-filter-ui": "1.0.3",
    "@univerjs/sheets-find-replace": "1.0.3",
    "@univerjs/sheets-hyper-link-ui": "1.0.3",
    "@univerjs/sheets-note": "1.0.3",
    "@univerjs/sheets-sort": "1.0.3",
    "@univerjs/sheets-sort-ui": "1.0.3",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "openai": "^7.41.0",
    "perfect-freehand": "^1.2.3",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "unpdf": "^1.9.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@dlient/lakex-doc-react": "file:./vendor/lakex-doc-react",
    "@tanstack/react-virtual": "3.14.19",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "lakex-drawnix": "^0.1.0",
    "lakex-drawnix-react-board": "^0.1.0",
    "lakex-drawnix-react-text": "^0.1.0",
    "lucide-react": "^1.61.0",
    "patch-package": "^8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.106.1",
    "slate": "^0.116.0",
    "slate-dom": "^0.116.0",
    "slate-react": "^0.116.0",
    "sql.js": "^1.15.1",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.lakexlocalnotes.desktop",
    "productName": "LakexLocalNotes",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "electron/boot.html",
      "!**/*.map",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/build/Release/obj/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "electron/preload.cjs"
    ],
    "icon": "build/icon.png"
  },
  "license": "AGPL-3.0-only"
}
