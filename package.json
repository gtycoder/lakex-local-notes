{
  "name": "lake-notes-electron",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 Lake 编辑器笔记应用（Electron 桌面端）",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:1421 && electron .\"",
    "dev:vite": "vite --host 127.0.0.1 --port 1421",
    "dev:electron": "electron .",
    "build": "tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "better-sqlite3": "^11.3.0",
    "lakex-drawnix": "^0.1.0",
    "lakex-drawnix-react-board": "^0.1.0",
    "lakex-drawnix-react-text": "^0.1.0",
    "lakex-editor-react-component": "^0.1.2",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.3",
    "slate": "^0.116.0",
    "slate-dom": "^0.116.0",
    "slate-react": "^0.116.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vite": "latest",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "latest",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.lakenotes.electron",
    "productName": "Lake Notes",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "!**/*.map",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/build/Release/obj/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "electron/preload.cjs"
    ]
  }
}
