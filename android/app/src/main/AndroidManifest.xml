<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 261117 用户点单「卸载不删资源 / 卸载时给弹窗」的 Android 官方能力：
         android:hasFragileUserData="true" ⇒ **Android 10（API 29）及以上**从系统「应用详情 / 系统卸载对话框」
         卸载时会多一个「保留应用数据」选项，勾选后重装数据仍在；低版本系统忽略该属性、不报错。
         局限（详见 docs/mobile/UNINSTALL-DATA.md）：① 只在系统卸载对话框出现——桌面长按图标直接拖走、
         或 ADB pm uninstall 不会问；② Android 9 及以下没有该能力。
         allowBackup 保持 **false**：本机数据（正文/附件/历史）通常远超 Auto Backup 的 25MB 限额，
         且正文不加密，走 Google Drive 自动备份既不可靠也不符合隐私预期；迁移改由「保留数据 + 应用内
         备份引导（桌面导出便携包 / 云同步）」承担。因此也不配置 fullBackupContent / dataExtractionRules。 -->
    <application
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统分享 → LakexLocalNotes（文本 / 图片 / PDF）：@capacitor 的 SharedContentPlugin 接住后再按 kind 分流 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- 261102 T2-C：PDF 分享入口。只声明 application/pdf（不声明 application/octet-stream：
                 那会让 App 出现在所有二进制的分享目标里）；octet-stream 的发送方由插件按 DISPLAY_NAME 兜底，
                 只有在 intent 真的到达时才有机会命中。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- 261106：Markdown 分享入口（单文件）。text/plain 已有上面那条 ⇒ 分享方把 .md 标成纯文本也能进来，
                 插件再按 DISPLAY_NAME 的 .md/.markdown 后缀分类；这里补声明 markdown mime，让系统分享列表直接出现本 App。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
            <!-- 261106：Markdown 多文件分享（ACTION_SEND_MULTIPLE）；text/plain 也接，插件按扩展名过滤 .md。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 长按桌面图标 → 静态快捷方式列表（res/xml/shortcuts.xml） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- 261022：长按图标的「新建小记」走 alias（不同 splash 主题：纯色、无 logo），
             但目标仍是同一个 MainActivity（同一 WebView/内核/数据），不复制第二套 App。
             普通启动保持在 MainActivity 的带 logo 启动页上。 -->
        <activity-alias
            android:name=".QuickNoteAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBarLaunchNoLogo">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lakexlocalnotes" android:host="quick-note" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新（261109）：拉起系统安装器需要用户授权「安装未知应用」；isWifi 判据读网络能力。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
