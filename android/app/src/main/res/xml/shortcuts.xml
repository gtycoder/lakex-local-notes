<?xml version="1.0" encoding="utf-8"?>
<!-- 长按桌面图标出现的静态快捷方式（Android App Shortcuts）。
     「小记」= 直接进入新建小记：走 lakenotes://quick-note 深链，App 侧由 @capacitor/app 的
     appUrlOpen / getLaunchUrl 接住（见 src/mobile/quickNoteShortcut.ts）。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick-note"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_quick_note_short"
        android:shortcutLongLabel="@string/shortcut_quick_note_long">
        <!-- 原生秒开：直接开 QuickCaptureActivity（不走 WebView/内核）；提交写 inbox 由 App 导入为小记 -->
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lakenotes.mobile"
            android:targetClass="com.lakenotes.mobile.QuickCaptureActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
