# Development-only server variables. Copy this file to `.env.local`.
# Never prefix the API key with VITE_: VITE_ variables are exposed to browsers.
LAKEX_AI_API_KEY=replace-with-your-api-key
LAKEX_AI_ENDPOINT=https://api.edgefn.net/v1/chat/completions
LAKEX_AI_MODEL=GLM-5.2
LAKEX_AI_STREAM=true
LAKEX_AI_REQUEST_TIMEOUT_MS=360000
LAKEX_AI_IDLE_TIMEOUT_MS=120000
LAKEX_AI_MAX_RETRIES=1
LAKEX_AI_MAX_TOKENS=8192

# Set to true to bypass the provider and use examples/src/mockDrawingBoardAI.ts.
VITE_LAKEX_AI_USE_MOCK=false
